{
  "name": "edutrack",
  "version": "1.0.5",
  "description": "EduTrack — Professional Student Registration & Session Management for Tutoring Centers",
  "main": "main.js",
  "scripts": {
    "postinstall": "node -e \"require('fs').writeFileSync('node_modules/electron/path.txt', 'electron.exe')\"",
    "start": "electron .",
    "test": "jest --verbose",
    "test:watch": "jest --watchAll",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "release": "node build-tools/release.js"
  },
  "keywords": [
    "education",
    "students",
    "registration"
  ],
  "author": "EduTrack",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.0.3",
    "bytenode": "^1.6.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.3.6",
    "javascript-obfuscator": "^5.5.0",
    "jest": "^29.7.0"
  },
  "build": {
    "asar": true,
    "appId": "com.edutrack.student-management",
    "productName": "EduTrack",
    "copyright": "Copyright © 2025 EduTrack. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "EduTrack"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduTrack",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "main/**/*",
      "assets/**/*",
      "data/**/*",
      "whatsapp-service.js",
      "whatsapp-templates.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ]
  },
  "dependencies": {
    "googleapis": "^173.0.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  }
}