{
  "name": "edutrack",
  "version": "1.0.0",
  "description": "EduTrack — Professional Student Registration & Session Management for Tutoring Centers",
  "main": "main.js",
  "scripts": {
    "postinstall": "node -e \"require('fs').writeFileSync('node_modules/electron/path.txt', 'electron.exe')\"",
    "start": "electron .",
    "test": "jest --verbose",
    "test:watch": "jest --watchAll",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "education",
    "students",
    "registration"
  ],
  "author": "EduTrack",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.edutrack.student-management",
    "productName": "EduTrack",
    "copyright": "Copyright © 2025 EduTrack. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "EduTrack"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduTrack",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  }
}
